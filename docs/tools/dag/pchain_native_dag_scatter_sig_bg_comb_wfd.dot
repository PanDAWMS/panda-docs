digraph "scatter_sig_bg_comb" {
  compound=true;
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="transparent", nodesep=0.35, ranksep=0.55];
  node [fontname="Helvetica", fontsize=11, margin="0.16,0.09"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.8];

  "in_signals" [label="signals", shape=folder, style=filled, fillcolor="#e8eef7", color="#5a7fb0", fontcolor="#1f3552"];
  "in_backgrounds" [label="backgrounds", shape=folder, style=filled, fillcolor="#e8eef7", color="#5a7fb0", fontcolor="#1f3552"];
  subgraph "cluster_many_sig_bg_comb" {
    label="many_sig_bg_comb  (scatter)";
    graph [style="rounded,filled", fillcolor="#fafafa", color="#9aa5b1", fontcolor="#48525c", fontsize=11];
    "many_sig_bg_comb__make_signal" [label="make_signal\nabc.dat, def.zip", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "many_sig_bg_comb__make_background_1" [label="make_background_1\nopq.root, xyz.pool", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "many_sig_bg_comb__generate_some" [label="generate_some\ngen.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "many_sig_bg_comb__premix" [label="premix\nklm.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "many_sig_bg_comb__make_background_2" [label="make_background_2\nooo.root, jjj.txt", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "many_sig_bg_comb__combine" [label="combine\naaa.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "many_sig_bg_comb__make_signal" -> "many_sig_bg_comb__premix" [label="def.zip"];
    "many_sig_bg_comb__make_background_1" -> "many_sig_bg_comb__premix" [label="xyz.pool", style=dashed, color="#7a7a7a"];
    "many_sig_bg_comb__generate_some" -> "many_sig_bg_comb__make_background_2" [label="gen.root", style=dashed, color="#7a7a7a"];
    "many_sig_bg_comb__make_signal" -> "many_sig_bg_comb__combine" [label="abc.dat"];
    "many_sig_bg_comb__premix" -> "many_sig_bg_comb__combine" [label="klm.root", style=dashed, color="#7a7a7a"];
    "many_sig_bg_comb__make_background_2" -> "many_sig_bg_comb__combine" [label="ooo.root", style=dashed, color="#7a7a7a"];
  }
  "in_signals" -> "many_sig_bg_comb__make_signal";
  "in_backgrounds" -> "many_sig_bg_comb__make_background_1";
  "in_backgrounds" -> "many_sig_bg_comb__make_background_2";
  "merge" [label="merge\nmerged.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
  "many_sig_bg_comb__combine" -> "merge" [ltail="cluster_many_sig_bg_comb"];
  "out_final_result" [label="final_result\nmerged.root", shape=folder, style=filled, fillcolor="#e6f2e6", color="#5a9a5a", fontcolor="#1f4d1f"];
  "merge" -> "out_final_result";
}
