digraph "nested_workflow_sig_bg_comb" {
  compound=true;
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="transparent", nodesep=0.35, ranksep=0.55];
  node [fontname="Helvetica", fontsize=11, margin="0.16,0.09"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.8];

  "top" [label="top\nseed.txt", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
  subgraph "cluster_sig_bg_comb" {
    label="sig_bg_comb  (signal_background_combine_wfd.yaml)";
    graph [style="rounded,filled", fillcolor="#fafafa", color="#9aa5b1", fontcolor="#48525c", fontsize=11];
    "sig_bg_comb__in_signal" [label="signal\n...HITS.e8312_s3238_tid26378578_00", shape=folder, style=filled, fillcolor="#e8eef7", color="#5a7fb0", fontcolor="#1f3552"];
    "sig_bg_comb__in_background" [label="background\n...w.merge.HITS.e6446_s3238_s3250/", shape=folder, style=filled, fillcolor="#e8eef7", color="#5a7fb0", fontcolor="#1f3552"];
    "sig_bg_comb__make_signal" [label="make_signal\nabc.dat, def.zip", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "sig_bg_comb__make_background_1" [label="make_background_1\nopq.root, xyz.pool", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "sig_bg_comb__generate_some" [label="generate_some\ngen.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "sig_bg_comb__premix" [label="premix\nklm.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "sig_bg_comb__make_background_2" [label="make_background_2\nooo.root, jjj.txt", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "sig_bg_comb__combine" [label="combine\naaa.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
    "sig_bg_comb__in_signal" -> "sig_bg_comb__make_signal";
    "sig_bg_comb__in_background" -> "sig_bg_comb__make_background_1";
    "sig_bg_comb__make_signal" -> "sig_bg_comb__premix" [label="def.zip"];
    "sig_bg_comb__make_background_1" -> "sig_bg_comb__premix" [label="xyz.pool", style=dashed, color="#7a7a7a"];
    "sig_bg_comb__in_background" -> "sig_bg_comb__make_background_2";
    "sig_bg_comb__generate_some" -> "sig_bg_comb__make_background_2" [label="gen.root", style=dashed, color="#7a7a7a"];
    "sig_bg_comb__make_signal" -> "sig_bg_comb__combine" [label="abc.dat"];
    "sig_bg_comb__premix" -> "sig_bg_comb__combine" [label="klm.root", style=dashed, color="#7a7a7a"];
    "sig_bg_comb__make_background_2" -> "sig_bg_comb__combine" [label="ooo.root", style=dashed, color="#7a7a7a"];
  }
  "bottom" [label="bottom\nresults.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
  "sig_bg_comb__combine" -> "bottom" [ltail="cluster_sig_bg_comb"];
  "top" -> "bottom" [label="seed.txt", style=dashed, color="#7a7a7a"];
  "out_final_result" [label="final_result\nresults.root", shape=folder, style=filled, fillcolor="#e6f2e6", color="#5a9a5a", fontcolor="#1f4d1f"];
  "bottom" -> "out_final_result";
}
