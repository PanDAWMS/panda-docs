digraph "simple_chain" {
  compound=true;
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="transparent", nodesep=0.35, ranksep=0.55, pad="0.12,0.18"];
  node [fontname="Helvetica", fontsize=11, margin="0.16,0.09"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.8];

  "in_input" [label="input\n...HITS.e8312_s3238_tid26378578_00", shape=folder, style=filled, fillcolor="#e8eef7", color="#5a7fb0", fontcolor="#1f3552"];
  "top" [label="top\nintermediate.txt", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
  "bottom" [label="bottom\nresults.root", shape=box, style="rounded,filled", fillcolor="#fdf3e0", color="#c08b3e", fontcolor="#4d3410"];
  "in_input" -> "top";
  "top" -> "bottom";
  "out_final_output" [label="final_output\nresults.root", shape=folder, style=filled, fillcolor="#e6f2e6", color="#5a9a5a", fontcolor="#1f4d1f"];
  "bottom" -> "out_final_output";
}
